# Server Configuration
PORT=3000
NODE_ENV=development

# RPC URLs - Add your RPC endpoints here
# You can use public endpoints or services like Alchemy, Infura, QuickNode
RPC_URL_ETH=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Alternative: Use public RPC endpoints (may have rate limits)
# RPC_URL_ETH=https://eth.llamarpc.com
# RPC_URL_POLYGON=https://polygon-rpc.com
# RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/wallet_tracker

# CoinGecko API (Free tier available)
# Get your API key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY
# For free tier, you can leave this empty or use:
# COINGECKO_API_KEY=

# Optional: Rate limiting configuration
MAX_REQUESTS_PER_MINUTE=30
